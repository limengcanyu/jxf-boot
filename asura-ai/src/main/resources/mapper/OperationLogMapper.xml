<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.asura.ai.mapper.OperationLogMapper">

    <select id="selectByUserId" resultType="org.asura.ai.entity.OperationLog">
        SELECT * FROM operation_log WHERE user_id = #{userId} ORDER BY timestamp DESC
    </select>

    <select id="selectByOperation" resultType="org.asura.ai.entity.OperationLog">
        SELECT * FROM operation_log WHERE operation = #{operation} ORDER BY timestamp DESC
    </select>

</mapper>
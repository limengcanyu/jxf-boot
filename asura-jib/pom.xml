<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.jiangxingfeng</groupId>
		<artifactId>asura-boot</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>asura-jib</artifactId>

	<dependencies>
		<dependency>
			<groupId>org.asura.webmvc.deps</groupId>
			<artifactId>asura-webmvc-deps</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Source: https://mvnrepository.com/artifact/com.google.cloud.tools/jib-maven-plugin -->
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<from>
						<!-- 基础镜像 -->
						<image>eclipse-temurin:25.0.3_9-jre-jammy</image>
					</from>
					<to>
						<!-- 镜像名称和tag -->
						<image>rock-boot/spring-boot-jib:${project.version}</image>
					</to>
					<!-- 镜像文件名称 -->
					<outputPaths>
						<tar>target/${project.artifactId}.tar</tar>
						<digest>target/${project.artifactId}.digest</digest>
						<imageId>target/${project.artifactId}.id</imageId>
						<imageJson>target/${project.artifactId}.json</imageJson>
					</outputPaths>
				</configuration>
				<executions>
					<execution>
						<!-- 编译阶段 -->
						<phase>compile</phase>
						<goals>
							<!-- 构建镜像文件 -->
							<goal>buildTar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

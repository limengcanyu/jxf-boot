<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.asura.flaw.dao.mapper.ExampleTableMapper">

    <select id="getListByUserId" parameterType="java.lang.String"
            resultType="org.asura.flaw.dao.entity.ExampleTable">
        SELECT id, user_id, password, zh_name, age, address
        FROM example_table
        where user_id like concat('%', #{userId}, '%')
    </select>

</mapper>

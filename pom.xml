        <module>asura-mybatis-plus</module>
        <module>asura-mybatis-plus-druid-dynamic-datasource</module>
        <module>asura-mybatis-plus-druid-multi-datasource</module>
        <module>asura-mybatis-plus-sharding-jdbc</module>
        <module>asura-neo4j</module>
        <module>asura-netty</module>

        <module>asura-code-executor</module>
        <module>asura-common</module>
        <module>asura-completablefuture</module>
        <module>asura-configuration-processor</module>
        <module>asura-couchbase</module>
        <module>asura-custom-starter</module>
        <module>asura-custom-starter-test</module>
        <module>asura-ddd-structure</module>
        <module>asura-disruptor</module>
        <module>asura-doris</module>
        <module>asura-easyexcel</module>
        <module>asura-elasticsearch</module>
        <module>asura-example</module>
        <module>asura-fastexcel</module>
        <module>asura-flaw</module>
        <module>asura-flowable</module>
        <module>asura-graphql</module>
        <module>asura-graphql-java-kickstart</module>
        <module>asura-guava</module>
        <module>asura-hazelcast</module>
        <module>asura-httpcomponents</module>
        <module>asura-hutool</module>
        <module>asura-hystrix</module>
        <module>asura-i18n</module>
        <module>asura-influxdb</module>
        <module>asura-jackson</module>
        <module>asura-jdbc</module>
        <module>asura-jib</module>
        <module>asura-jkube</module>
        <module>asura-jooq</module>
        <module>asura-jpa</module>
        <module>asura-jwt</module>
        <module>asura-kafka</module>
        <module>asura-kafka-streams</module>
        <module>asura-knife4j</module>
